#!/bin/bash
set -euo pipefail

if ! command -v brew >/dev/null 2>&1; then
  # Not NONINTERACTIVE: creating /opt/homebrew requires root to create and
  # chown it, so this needs to prompt for an admin password once. That's a
  # real macOS privilege boundary, not something to script around.
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
eval "$(/opt/homebrew/bin/brew shellenv)"

# Brewfile hash: {{ include "Brewfile" | sha256sum }}

brew bundle --file={{ joinPath .chezmoi.sourceDir "Brewfile" | quote }}
