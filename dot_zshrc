# Force emacs keybindings. zsh defaults to vi mode when $EDITOR contains
# "vi" (case-insensitive substring match) — "nvim" matches, so without this
# the shell silently ends up in vi mode (e.g. Ctrl+A does nothing useful and
# Esc+Backspace doesn't delete a word, since Esc first exits to vi command
# mode instead of acting as the emacs Meta prefix).
bindkey -e

source "${ZGEN_DIR:-$HOME/.zgen}/zgen.zsh"

if ! zgen saved; then
  zgen load superbrothers/zsh-kubectl-prompt

  zgen load krak3n/zsh-theme krak3n.zsh-theme
  zgen save
fi

autoload -Uz compinit
compinit

# Interactive completion menu, so repeated Tab cycles through candidates and
# Shift+Tab cycles backwards (needs menu select; complist provides the
# menuselect keymap; kcbt is the terminal's actual Shift+Tab sequence)
zmodload -i zsh/complist
zstyle ':completion:*' menu select
setopt auto_menu
[[ -n ${terminfo[kcbt]} ]] && bindkey "${terminfo[kcbt]}" reverse-menu-complete

# Ctrl+Left/Right jump by word. No terminfo capname for these (kLFT5/kRIT5
# aren't in macOS's bundled ncurses), but "\e[1;5D"/"\e[1;5C" is the
# near-universal xterm-style sequence modern terminals (Ghostty included)
# send for them.
bindkey '\e[1;5D' backward-word
bindkey '\e[1;5C' forward-word

# Directory navigation (replicates oh-my-zsh's lib/directories.zsh, which is
# plain zsh under the hood — no framework needed)
setopt auto_cd
setopt auto_pushd
setopt pushd_ignore_dups
setopt pushdminus

alias -g ...='../..'
alias -g ....='../../..'
alias -g .....='../../../..'
alias -g ......='../../../../..'

alias -- -='cd -'
alias 1='cd -1'
alias 2='cd -2'
alias 3='cd -3'
alias 4='cd -4'
alias 5='cd -5'
alias 6='cd -6'
alias 7='cd -7'
alias 8='cd -8'
alias 9='cd -9'

alias md='mkdir -p'
alias rd=rmdir

function d () {
  if [[ -n $1 ]]; then
    dirs "$@"
  else
    dirs -v | head -n 10
  fi
}
compdef _dirs d

alias lsa='ls -lah'
alias l='ls -lah'
alias ll='ls -lh'
alias la='ls -lAh'

eval "$(direnv hook zsh)"
eval "$(mise activate zsh)"
source <(fzf --zsh)

command -v kubectl >/dev/null && source <(kubectl completion zsh)
command -v helm >/dev/null && source <(helm completion zsh)
command -v docker >/dev/null && source <(docker completion zsh)

# Tailscale.app bundles a full CLI, but it must be run via its real path --
# a symlink breaks its bundle-identity check ("bundleIdentifier is unknown
# to the registry"), so a function is used instead of a PATH symlink.
if [ -x "/Applications/Tailscale.app/Contents/MacOS/Tailscale" ]; then
  function tailscale { /Applications/Tailscale.app/Contents/MacOS/Tailscale "$@" }
fi
