# Manage your dotfiles across multiple diverse machines, securely
brew "chezmoi"
# Neovim version manager
brew "bob"
# GitHub command-line tool
brew "gh"
# Distributed revision control system
brew "git"
# Display directories as trees (with optional color/HTML output)
brew "tree"
# Parser generator tool and incremental parsing library (CLI, needed by nvim-treesitter to compile parsers)
brew "tree-sitter-cli"
# Fast and simple Node.js version manager
brew "fnm"
# Search tool like grep, but faster (used by telescope.nvim's live_grep)
brew "ripgrep"
# Simple, fast alternative to find (used by telescope.nvim's find_files/frecency)
brew "fd"
# Agent multiplexer that lives in your terminal
brew "herdr"
# Lua interpreter (dependency for herdr-pickr plugin)
brew "lua"
# libuv bindings for Lua (dependency for herdr-pickr plugin)
brew "luv"
# Command-line fuzzy finder (dependency for herdr-pickr plugin)
brew "fzf"
# Terminal-based AI coding assistant
cask "claude-code"
# Terminal emulator that uses platform-native UI and GPU acceleration
cask "ghostty"
# Mesh VPN for remote SSH access (e.g. TermRover mobile -> this Mac)
cask "tailscale-app"
# Keyboard remapper (fixes UK PC keyboard grave/pipe key swap on macOS)
cask "karabiner-elements"
# Terminal UI for git (used standalone via herdr and inside nvim via lazygit.nvim)
brew "lazygit"
# Load/unload environment variables based on $PWD
brew "direnv"
# Kubernetes command-line interface
brew "kubernetes-cli"
# Run local Kubernetes clusters in Docker
brew "kind"
# Container runtime (Docker-compatible) needed for kind to run clusters
cask "rancher"
# Kubernetes package manager
brew "helm"
# Postgres client library (force-linked, it's keg-only by default)
brew "libpq", link: true
# GNU core utilities (ls, date, etc.), installed with a "g" prefix alongside macOS's BSD versions
brew "coreutils"
# GnuPG, for signing git commits
brew "gnupg"
# Native macOS passphrase dialog for gpg-agent
brew "pinentry-mac"
# Syntax-highlighting pager for git diffs
brew "git-delta"
# Fast way to switch between kubectl contexts/namespaces
brew "kubectx"
# FluxCD CLI, for GitOps continuous delivery on Kubernetes (not "flux", which is InfluxDB's unrelated query language and conflicts on the same binary name)
brew "fluxcd"
# Protocol Buffers tool, used by conform.nvim to format .proto files
brew "buf"
# Polyglot runtime version manager
brew "mise"
# Codecov CLI, for uploading coverage reports
brew "codecov-cli"
# Database migration manager
brew "flyway"
# Open source API client (Postman alternative)
cask "bruno"
# JSON processor, used by the Claude Code status line script
brew "jq"
