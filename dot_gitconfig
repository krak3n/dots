	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[user]
 	name = Chris Reeves
 	email = hey@krak3n.io
	signingkey = 503BA03E7EA4277B
[commit]
	gpgsign = true
[core]
 	editor = nvim
 	filemode = false
  pager = delta
[interactive]
  diffFilter = delta --color-only
[delta]
	features = onedark
	line-numbers = true
	navigate = true
[delta "onedark"]
	syntax-theme = TwoDark
	plus-style = syntax "#3c4740"
	plus-emph-style = syntax "#436650"
	minus-style = syntax "#4b363f"
	minus-emph-style = syntax "#6c3a44"
	line-numbers-plus-style = "#98c379"
	line-numbers-minus-style = "#e86671"
	line-numbers-zero-style = "#5c6370"
	file-style = "#61afef" bold
	file-decoration-style = "#61afef" ul
	hunk-header-style = line-number syntax
	hunk-header-decoration-style = "#c678dd" box
	hunk-header-file-style = "#61afef"
	hunk-header-line-number-style = "#e5c07b"
	commit-style = "#e5c07b" bold
	commit-decoration-style = "#e5c07b" box
[alias]
	co = checkout
	cobr = checkout -B
	br = branch
	cm = commit
	st = status
	ap = add -p
	ammend = commit --amend
	unstage = reset HEAD --
	last = log -1 HEAD
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an %ae>%Creset' --abbrev-commit
	up = pull
	lt = describe --tags --abbrev=0
	pl = "!git pull origin \"$(git symbolic-ref --short HEAD)\""
	ph = "!git push origin \"$(git symbolic-ref --short HEAD)\""
[color]
	ui = auto
[color "diff"]
	meta = blue bold
	frag = magenta bold
	old = red bold
	new = green bold
[color "status"]
	added = green
	changed = yellow
	untracked = red
[hub]
 	protocol = https
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	required = true
	process = git-lfs filter-process
[rebase]
	autoStash = true
[pull]
	rebase = true
[init]
	defaultBranch = main
[gpg]
	program = /opt/homebrew/bin/gpg
[includeIf "gitdir:~/Code/github.com/ori-edge/"]
	path = ~/.gitconfig-work
